{
  "mcpServers": {
    "usercase": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@usercase/mcp@0.2.10"
      ],
      "env": {
        "USERCASE_CLIENT": "codex"
      },
      "env_vars": [
        "USERCASE_API_KEY",
        "USERCASE_DIAGNOSTICS"
      ]
    }
  }
}
